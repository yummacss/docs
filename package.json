  "type": "module",
  "scripts": {
    "build": "node scripts/check-sidebar.mjs && node scripts/generate-registry-json.mjs && next build",
    "check-sidebar": "node scripts/check-sidebar.mjs",
    "check-types": "tsc --noEmit",
    "dev": "next dev",
    "format": "biome format --write .",
    "generate:registry": "node scripts/generate-registry.mjs",
    "generate:registry-json": "node scripts/generate-registry-json.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "sort": "sort-package-json",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "upd": "pnpm up yummacss \"@yummacss/*\" --latest",
    "validate": "node scripts/validate-yummacss.mjs"
  },
