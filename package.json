    "motion": "^13.4.0",
    "next": "16.3.5",
    "next-mdx-remote-client": "^2.1.12",
    "nuqs": "^2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
